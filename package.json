{
  "name": "astrbot-chat",
  "private": true,
  "version": "0.2.26",
  "description": "A local-first, cloud-ready chat client for AstrBot WebChat.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bff,web -c cyan,magenta \"node server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test server/web-assets.test.mjs server/proxy-token.test.mjs && node scripts/check-ps1-encoding.mjs",
    "sidecar:sync": "node scripts/sync-sidecar.mjs",
    "smoke": "node scripts/smoke.mjs",
    "ui:check": "tsc --noEmit && vite build && node scripts/ui-regression/check.mjs",
    "update:feed": "node scripts/update-feed.mjs",
    "ios:sync": "node node_modules/@capacitor/cli/bin/capacitor sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "8.6.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
