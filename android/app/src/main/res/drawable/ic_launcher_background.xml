<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层：和桌面端图标同一套蓝紫渐变（#7B8CF8 → #8B5CF6）。
  前景是 mipmap-*/ic_launcher_foreground.png（只有那个黑色的 A，四周留着安全区），
  由 scripts/android-icons.py 从 src-tauri/icons/icon.png 生成。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#7B8CF8" />
                <item android:offset="1" android:color="#8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
