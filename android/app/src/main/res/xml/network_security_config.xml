<?xml version="1.0" encoding="utf-8"?>
<!--
  只给 AstrBot Chat 自己用：信任「系统 CA」和「用户自己安装的 CA」，**不内置任何证书**。

  手机连电脑的 https://<IP>:8789 用的是电脑上临时生成的自签 CA（scripts/lan-tls.ps1
  或桌面端首次开启「手机访问」时生成），每台电脑都不一样。所以必须由用户在手机上装一次：
  浏览器打开 http://<电脑IP>:8788/ca.cer → 安装 → 设置里选「CA 证书」。

  早期版本把某一张 CA 打进 APK，结果是对别人无效（CA 不匹配），还把所有人的信任
  都绑到了同一条私钥上 —— 现在不再内置。

  不放开 cleartext：套壳版只走 https（http 源在 App 里会连不上，是有意的）。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
